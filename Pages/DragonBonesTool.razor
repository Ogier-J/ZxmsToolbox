@page "/tools/dragonbones"
@inject NavigationManager Nav

<PageTitle>DragonBones 即时预览</PageTitle>

<div class="db-page">
    <div class="db-header">
        <MudText Typo="Typo.h6">DragonBones 即时预览</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            纯浏览器运行 · 支持选择含多套资源的大文件夹，或手动加载单套骨骼 / 图集 / 贴图
        </MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" Href="dragonbones/index.html" Target="_blank"
                   StartIcon="@Icons.Material.Filled.OpenInNew">
            新窗口打开
        </MudButton>
    </div>
    <iframe src="dragonbones/index.html"
            class="db-iframe"
            title="DragonBones Preview"
            allow="fullscreen"
            referrerpolicy="no-referrer"></iframe>
</div>

<style>
    .db-page {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 64px);
        margin: -16px;
    }
    .db-header {
        flex: 0 0 auto;
        padding: 12px 16px 8px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-background);
    }
    .db-iframe {
        flex: 1 1 auto;
        width: 100%;
        border: none;
        background: #1a1a1e;
        min-height: 480px;
    }
</style>
