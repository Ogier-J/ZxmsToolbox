@page "/tools/color"

<PageTitle>颜色转换</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">颜色格式转换</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudTextField T="string" Label="HEX (如 #7e6fff 或 7e6fff)" Variant="Variant.Outlined"
                          @bind-Value="hexInput" Immediate="true" Class="mb-3" />
            <MudNumericField T="int" Label="R (0-255)" @bind-Value="r" Min="0" Max="255" Variant="Variant.Outlined" Class="mb-2" />
            <MudNumericField T="int" Label="G (0-255)" @bind-Value="g" Min="0" Max="255" Variant="Variant.Outlined" Class="mb-2" />
            <MudNumericField T="int" Label="B (0-255)" @bind-Value="b" Min="0" Max="255" Variant="Variant.Outlined" Class="mb-3" />

            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FromHex">从 HEX 解析</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="FromRgb">从 RGB 生成</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1" Style="@($"background:{previewColor}; min-height:180px")">
            <MudText Typo="Typo.subtitle1" Style="color:white; text-shadow:0 0 4px #000">预览</MudText>
        </MudPaper>
        <MudPaper Class="pa-4 mt-3" Elevation="1">
            <MudText>HEX: <code>@hexResult</code></MudText>
            <MudText>RGB: <code>@rgbResult</code></MudText>
            <MudText>HSL: <code>@hslResult</code></MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string hexInput = "#7e6fff";
    private int r = 126, g = 111, b = 255;
    private string hexResult = "#7E6FFF";
    private string rgbResult = "rgb(126, 111, 255)";
    private string hslResult = "";
    private string previewColor = "#7e6fff";

    protected override void OnInitialized()
    {
        UpdateFromRgb();
    }

    private void FromHex()
    {
        var s = (hexInput ?? "").Trim().TrimStart('#');
        if (s.Length == 3)
            s = $"{s[0]}{s[0]}{s[1]}{s[1]}{s[2]}{s[2]}";
        if (s.Length != 6 || !int.TryParse(s, System.Globalization.NumberStyles.HexNumber, null, out int val))
        {
            hexResult = "无效 HEX";
            return;
        }
        r = (val >> 16) & 0xFF;
        g = (val >> 8) & 0xFF;
        b = val & 0xFF;
        UpdateFromRgb();
    }

    private void FromRgb()
    {
        r = Math.Clamp(r, 0, 255);
        g = Math.Clamp(g, 0, 255);
        b = Math.Clamp(b, 0, 255);
        UpdateFromRgb();
    }

    private void UpdateFromRgb()
    {
        hexResult = $"#{r:X2}{g:X2}{b:X2}";
        rgbResult = $"rgb({r}, {g}, {b})";
        previewColor = hexResult;
        hslResult = RgbToHsl(r, g, b);
    }

    private static string RgbToHsl(int r, int g, int b)
    {
        double rd = r / 255.0, gd = g / 255.0, bd = b / 255.0;
        double max = Math.Max(rd, Math.Max(gd, bd));
        double min = Math.Min(rd, Math.Min(gd, bd));
        double h = 0, s, l = (max + min) / 2;
        if (max == min)
        {
            h = s = 0;
        }
        else
        {
            double d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            if (max == rd) h = (gd - bd) / d + (gd < bd ? 6 : 0);
            else if (max == gd) h = (bd - rd) / d + 2;
            else h = (rd - gd) / d + 4;
            h /= 6;
        }
        return $"hsl({(int)(h * 360)}, {(int)(s * 100)}%, {(int)(l * 100)}%)";
    }
}
