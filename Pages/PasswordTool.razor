@page "/tools/password"

<PageTitle>密码生成器</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">随机密码生成器</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudNumericField T="int" Label="密码长度" @bind-Value="length" Min="4" Max="128" Variant="Variant.Outlined" Class="mb-3" Style="max-width:200px" />
    <MudNumericField T="int" Label="生成数量" @bind-Value="count" Min="1" Max="50" Variant="Variant.Outlined" Class="mb-3" Style="max-width:200px" />

    <MudCheckBox T="bool" @bind-Value="useLower" Label="小写字母 (a-z)" Color="Color.Primary" />
    <MudCheckBox T="bool" @bind-Value="useUpper" Label="大写字母 (A-Z)" Color="Color.Primary" />
    <MudCheckBox T="bool" @bind-Value="useDigit" Label="数字 (0-9)" Color="Color.Primary" />
    <MudCheckBox T="bool" @bind-Value="useSymbol" Label="@symbolLabel" Color="Color.Primary" />
</MudPaper>

<MudStack Row="true" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate">生成密码</MudButton>
    <MudButton Variant="Variant.Text" OnClick="Clear">清空</MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(output))
{
    <MudTextField T="string" Label="生成结果" Variant="Variant.Outlined" Lines="10"
                  Value="@output" ReadOnly="true" Style="font-family:monospace" />
}

@code {
    private int length = 16;
    private int count = 5;
    private bool useLower = true;
    private bool useUpper = true;
    private bool useDigit = true;
    private bool useSymbol = true;
    private string output = "";

    private const string symbolLabel = "特殊符号 (!@#$%^&*)";
    private static readonly string Lower = "abcdefghijklmnopqrstuvwxyz";
    private static readonly string Upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    private static readonly string Digit = "0123456789";
    private static readonly string Symbol = "!@#$%^&*()_+-=[]{}|;:,.<>?";

    private void Generate()
    {
        var charset = "";
        if (useLower) charset += Lower;
        if (useUpper) charset += Upper;
        if (useDigit) charset += Digit;
        if (useSymbol) charset += Symbol;

        if (string.IsNullOrEmpty(charset))
        {
            output = "请至少选择一种字符类型";
            return;
        }

        var rng = Random.Shared;
        var list = new List<string>();
        for (int i = 0; i < count; i++)
        {
            var chars = new char[length];
            for (int j = 0; j < length; j++)
                chars[j] = charset[rng.Next(charset.Length)];
            list.Add(new string(chars));
        }
        output = string.Join("\n", list);
    }

    private void Clear()
    {
        output = "";
    }
}
